+def device_sync_allowed(config: DeviceTargets, device_folder: str) -> bool:
+    """Never refill a folder delegated to on-demand storage, including overlaps."""
+    requested = PurePosixPath(_safe_relative(device_folder, "device folder"))
+    for folder in config.device.on_demand_folders:
+        excluded = PurePosixPath(folder)
+        if requested == excluded or excluded in requested.parents or requested in excluded.parents:
+            return False
+    return True
+
+
+def require_device_sync_allowed(config: DeviceTargets, device_folder: str) -> None:
+    if not device_sync_allowed(config, device_folder):
+        raise SyncPlanningError(
+            f"Device sync disabled for on-demand ROM folder: {device_folder}. "
+            "Archive downloads are unchanged; this target must be managed by R-Shop."
+        )
+
