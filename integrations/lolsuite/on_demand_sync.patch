diff --git a/tests/test_device_sync_exclusion.py b/tests/test_device_sync_exclusion.py
new file mode 100644
--- /dev/null
+++ b/tests/test_device_sync_exclusion.py
@@ -0,0 +1,185 @@
+"""Bounded S7 no-refill contract; no real ADB operation or ROM read."""
+import hashlib
+import io
+import json
+import tempfile
+import unittest
+from dataclasses import asdict, replace
+from datetime import datetime, timezone
+from pathlib import Path
+from unittest import mock
+
+import device_policy
+import device_sync as ds
+import lolroms_downloader as downloader
+from tests.test_device_sync import target_config
+
+MANAGER = Path(__file__).resolve().parents[1]
+TEMP = Path(r"D:\Temp")
+
+
+class DeviceSyncExclusionTests(unittest.TestCase):
+    def config(self, folders=None):
+        raw = target_config()
+        if folders is not None:
+            raw['device']['on_demand_folders'] = folders
+        with tempfile.TemporaryDirectory(dir=TEMP) as directory:
+            path = Path(directory) / 'config.json'
+            path.write_text(json.dumps(raw), encoding='utf-8')
+            try:
+                return ds.load_device_targets(path)
+            except ds.SyncConfigError as exc:
+                self.fail(f"Valid device-only exclusions rejected: {exc}")
+
+    def coverage(self):
+        return ds.load_coverage_registry(MANAGER / 'profiles/device-coverage.json')
+
+    def plan(self, config):
+        target = config.targets[0]
+        return ds.create_sync_plan(
+            brand=target.brand, system=target.system, policy=target.device_policy,
+            device_root=ds._device_root(config, target),
+            identity=ds.DeviceIdentity('thor-serial', 'AYN Thor', 'Thor', 'Thor',
+                                       'test-build', 'a' * 64),
+            resolution=ds.ArtifactResolution((), (), ()), actions=(),
+            capacity=ds.CapacityEvaluation(0, 0, 1000, True),
+            created_at=datetime(2026, 10, 6, tzinfo=timezone.utc))
+
+    def test_loads_optional_exclusions_without_changing_targets(self):
+        original = self.config()
+        guarded = self.config(['gc', 'psx'])
+        self.assertEqual(guarded.device.on_demand_folders, ('gc', 'psx'))
+        self.assertEqual(guarded.targets, original.targets)
+        self.assertEqual(original.device.on_demand_folders, ())
+
+    def test_invalid_or_duplicate_exclusions_are_rejected(self):
+        for folders in ('gc', None, [True], [''], ['/gc'], ['../gc'],
+                        ['gc', 'gc/'], ['C:/gc']):
+            with self.subTest(folders=folders), tempfile.TemporaryDirectory(dir=TEMP) as directory:
+                raw = target_config()
+                raw['device']['on_demand_folders'] = folders
+                path = Path(directory) / 'config.json'
+                path.write_text(json.dumps(raw), encoding='utf-8')
+                with self.assertRaises(ds.SyncConfigError):
+                    ds.load_device_targets(path)
+
+    def test_folder_overlap_is_blocked_but_siblings_are_allowed(self):
+        config = self.config(['gc', 'nes/DiskSystem'])
+        for folder in ('gc', 'gc/subfolder', 'nes', 'nes/DiskSystem'):
+            self.assertFalse(ds.device_sync_allowed(config, folder), folder)
+        for folder in ('psp', 'gcs', 'nes/Hacks', 'n64'):
+            self.assertTrue(ds.device_sync_allowed(config, folder), folder)
+
+    def test_both_planners_reject_before_selection_or_adb(self):
+        config = self.config(['gc'])
+        target = config.targets[0]
+        coverage_target = self.coverage().target_for('nintendo-gamecube')
+        with mock.patch.object(ds, 'discover_adb_endpoints', side_effect=AssertionError('Unexpected ADB')), \
+             mock.patch.object(ds, 'resolve_artifacts', side_effect=AssertionError('Unexpected selection')), \
+             mock.patch.object(ds, 'resolve_coverage_target', side_effect=AssertionError('Unexpected selection')):
+            with self.assertRaisesRegex(ds.SyncPlanningError, 'on-demand'):
+                ds.build_live_plan(MANAGER, config, target)
+            with self.assertRaisesRegex(ds.SyncPlanningError, 'on-demand'):
+                ds.build_live_coverage_plan(MANAGER, MANAGER.parent, config, coverage_target)
+
+    def test_existing_plan_is_rejected_by_both_bindings(self):
+        config = self.config(['gc'])
+        plan = self.plan(config)
+        target = config.targets[0]
+        with self.assertRaisesRegex(ds.SyncPlanningError, 'on-demand'):
+            ds.validate_apply_target_binding(plan, config, target)
+        with self.assertRaisesRegex(ds.SyncPlanningError, 'on-demand'):
+            ds.validate_coverage_apply_target_binding(
+                plan, config, self.coverage().target_for('nintendo-gamecube'), 'top-50')
+        enabled = self.config()
+        ds.validate_apply_target_binding(plan, enabled, enabled.targets[0])
+
+    def test_both_cli_apply_paths_refuse_old_plan_without_adb(self):
+        config = self.config(['gc'])
+        plan = self.plan(config)
+        with mock.patch.object(ds, 'load_device_targets', return_value=config), \
+             mock.patch.object(ds, 'load_immutable_plan', return_value=plan), \
+             mock.patch.object(ds, 'discover_adb_endpoints', side_effect=AssertionError('Unexpected ADB')):
+            for command, extras in (('apply', []), ('coverage-apply', ['--target-id', 'nintendo-gamecube'])):
+                with self.subTest(command=command), self.assertRaisesRegex(ds.SyncPlanningError, 'on-demand'):
+                    ds.main([command, '--manager-root', str(MANAGER), '--plan', 'unused.json',
+                             '--confirm-transfer', *extras])
+
+    def test_both_cli_bootstrap_paths_refuse_excluded_ownership(self):
+        config = self.config(['gc'])
+        with mock.patch.object(ds, 'load_device_targets', return_value=config), \
+             mock.patch.object(ds, 'discover_adb_endpoints', side_effect=AssertionError('Unexpected ADB')):
+            for command, extras in (
+                ('bootstrap', ['--brand', 'Nintendo', '--system', 'GameCube']),
+                ('coverage-bootstrap', ['--target-id', 'nintendo-gamecube', '--library-root', str(MANAGER.parent)]),
+            ):
+                with self.subTest(command=command), self.assertRaisesRegex(ds.SyncPlanningError, 'on-demand'):
+                    ds.main([command, '--manager-root', str(MANAGER),
+                             '--expected-plan-id', 'a' * 64, *extras])
+
+    def test_plan_all_reports_exclusion_and_keeps_other_targets(self):
+        config = self.config(['gc'])
+        sibling = replace(config.targets[0], system='Wii', device_folder='wii')
+        config = replace(config, targets=(*config.targets, sibling))
+        registry = self.coverage()
+        registry = replace(registry, targets=(registry.target_for('nintendo-gamecube'),
+                                             registry.target_for('sony-psp')))
+        for command, builder, extras, expected_folder in (
+            ('plan', 'build_live_plan', [], 'wii'),
+            ('coverage-plan', 'build_live_coverage_plan', ['--library-root', str(MANAGER.parent)], 'psp'),
+        ):
+            output = io.StringIO()
+            with self.subTest(command=command), \
+                 mock.patch.object(ds, 'load_device_targets', return_value=config), \
+                 mock.patch.object(ds, 'load_coverage_registry', return_value=registry), \
+                 mock.patch.object(ds, builder, return_value=self.plan(config)) as build, \
+                 mock.patch.object(ds, 'write_immutable_plan', return_value=Path('unused.json')), \
+                 mock.patch('sys.stdout', output):
+                self.assertEqual(ds.main([command, '--manager-root', str(MANAGER),
+                                          '--output', 'unused', *extras]), 0)
+            rows = json.loads(output.getvalue())
+            self.assertEqual(len(rows), 2)
+            self.assertTrue(rows[0]['sync_disabled'])
+            self.assertEqual(build.call_count, 1)
+            self.assertEqual(build.call_args.args[-1].device_folder, expected_folder)
+
+    def test_ui_omits_excluded_targets_and_post_download_offer(self):
+        config = self.config(['gc', 'psx'])
+        registry = self.coverage()
+        choices = downloader.device_sync_target_choices(registry, config=config)
+        ids = {choice[1] for choice in choices}
+        self.assertNotIn('nintendo-gamecube', ids)
+        self.assertNotIn('sony-playstation', ids)
+        self.assertIn('sony-psp', ids)
+        with mock.patch.object(ds, 'load_device_targets', return_value=config):
+            self.assertEqual(downloader._coverage_target_ids_for_collection('Nintendo', 'GameCube'), ())
+
+    def test_explicit_ui_target_does_not_create_a_plan(self):
+        config = self.config(['gc'])
+        with mock.patch.object(ds, 'load_device_targets', return_value=config), \
+             mock.patch.object(ds, 'build_live_coverage_plan', side_effect=AssertionError('Unexpected plan')), \
+             mock.patch.object(downloader, 'fullscreen_message') as message:
+            self.assertEqual(downloader.run_device_sync_menu('nintendo-gamecube'), 0)
+            self.assertIn('on-demand', message.call_args.args[1])
+
+    def test_selection_revisions_retain_pre_exclusion_hashes(self):
+        config = ds.load_device_targets(MANAGER / 'profiles/device-targets.json')
+        target = config.target_for('Nintendo', 'GameCube')
+        old_device = {key: value for key, value in asdict(config.device).items()
+                      if key != 'on_demand_folders'}
+        profile = ds._load_json(MANAGER / 'profiles' / target.profile, 'profile')
+        payload = {'target': asdict(target), 'device': old_device, 'profile': profile}
+        expected = hashlib.sha256(json.dumps(payload, sort_keys=True, ensure_ascii=False).encode()).hexdigest()
+        self.assertEqual(device_policy.profile_selection_revision(MANAGER, target, config), expected)
+        guarded = replace(config, device=replace(config.device, on_demand_folders=('gc',)))
+        self.assertEqual(device_policy.profile_selection_revision(MANAGER, target, guarded), expected)
+        coverage = self.coverage().target_for('nintendo-gamecube')
+        payload = {'target': asdict(coverage), 'device': old_device,
+                   'inputs': {'profile_target': asdict(target), target.profile: profile}}
+        expected = hashlib.sha256(json.dumps(payload, sort_keys=True, ensure_ascii=False).encode()).hexdigest()
+        self.assertEqual(device_policy.selection_revision(MANAGER, coverage, config), expected)
+        self.assertEqual(device_policy.selection_revision(MANAGER, coverage, guarded), expected)
+
+
+if __name__ == '__main__':
+    unittest.main()
